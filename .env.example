# From https://discord.com/developers/applications -> your app -> OAuth2
VITE_DISCORD_CLIENT_ID=your_application_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Server port (Vite dev server proxies /api here)
PORT=3001

# Optional: where scores.json is written (mount a persistent volume here in production)
# SCORES_DIR=/data

# Serverless hosts (Vercel) have no disk: set these to use Upstash Redis instead of the file.
# Vercel's Upstash integration fills them in automatically (KV_REST_API_URL/TOKEN also work).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Local-only: lets you play in a normal browser tab without Discord (never set in production)
DEV_FAKE_USER=1
