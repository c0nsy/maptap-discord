{
  "name": "maptap-discord",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Daily MapTap-style geography game as a Discord Activity",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite --config client/vite.config.js",
    "dev:server": "node --watch server/index.js",
    "build": "vite build --config client/vite.config.js",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.0.0",
    "d3-geo": "^3.1.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "three": "^0.170.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.0.11"
  }
}
