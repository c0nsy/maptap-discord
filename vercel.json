{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/reminder", "schedule": "0 14 * * *" },
    { "path": "/api/cron/weekly", "schedule": "0 14 * * 1" }
  ]
}
